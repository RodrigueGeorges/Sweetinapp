# Copie ce fichier en .env pour le développement local.
# En production, mets les mêmes valeurs dans les variables d'environnement EAS (environnement "production").

EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxx

# Identifiants de l'app (non secrets)
APP_BUNDLE_ID=app.sweetin.ios
APP_PACKAGE=app.sweetin.android
EAS_PROJECT_ID=

# Pages légales et contact affichés dans Réglages
EXPO_PUBLIC_PRIVACY_URL=https://sweetinapp.netlify.app/confidentialite
EXPO_PUBLIC_TERMS_URL=https://sweetinapp.netlify.app/conditions
EXPO_PUBLIC_SUPPORT_EMAIL=team@sweetin.app

# Domaine des liens d'invitation https://<domaine>/u/<pseudo> (voir web/README.md)
# sweetinapp.netlify.app = temporaire ; remplace par ton domaine après l'achat
APP_LINK_DOMAIN=sweetinapp.netlify.app
EXPO_PUBLIC_INVITE_BASE=https://sweetinapp.netlify.app/u/

# Identifiant d'équipe Apple (requis pour signer le widget iOS et pour les liens universels du site)
APPLE_TEAM_ID=

# Pour scripts/mise-en-ligne.mjs (voir MISE-EN-LIGNE.md)
# Apple ID numérique de l'app (App Store Connect > Informations sur l'app)
APP_STORE_ID=
# Empreintes SHA-256 du certificat Android (EAS et Google Play), séparées par une virgule
ANDROID_SHA256=

# Suivi des plantages et statistiques anonymes (laisser vide pour désactiver)
EXPO_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Secrets des fonctions Edge — à définir avec `supabase secrets set`, pas dans ce fichier :
#   OPENAI_API_KEY        modération des photos/messages (obligatoire en prod, API de modération gratuite)
#   MODERATION_OPTIONAL   =1 pour désactiver la modération en développement seulement
#   CRON_SECRET           secret partagé des appels planifiés (en-tête x-cron-secret)

# Compte de test pour les smoke tests .pg-test/smoke*.mjs (jamais en prod)
SMOKE_EMAIL=
SMOKE_PASSWORD=
